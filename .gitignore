# Secrets and machine-specific configuration – never commit these
.env
.env.*
!.env.example
*.toml.local

# Python / uv / notebooks
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.marimo/
__marimo__/
.ipynb_checkpoints/
# Workspace members have no lock of their own; the root uv.lock is the one that counts
tools/*/uv.lock
notebooks/*/uv.lock
ops/*/uv.lock

# Tool outputs that are always regenerable
exports/
out/
# The operations suite's snapshots (the notebook's backup box writes under the data directory)
backups/
*.fixed
*.bak

# Simulation runs – multi-GB field data; the antenna folders in bac-hardware keep the small result files
tools/*/runs/
tools/bac-antenna-optimizer/**/*.log
sim/runs/**/simulation_port*/
sim/runs/**/*.h5
sim/runs/**/*.vtr
sim/runs/**/*.vtu
sim/runs/**/*.xml
sim/runs/**/error.txt
sim/runs/**/*.log

# Antenna visualizer – local sensitivity packs are attached to the antenna's release, not tracked here
notebooks/bac-antenna-visualizer/packs/
# Antenna visualizer demo – the notebook and its packs/ are tracked (molab fetches the packs from GitHub)
notebooks/bac-antenna-visualizer/demo/*
!notebooks/bac-antenna-visualizer/demo/bac_antenna_visualizer_demo.py
!notebooks/bac-antenna-visualizer/demo/packs/

# KiCad
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
_autosave-*
fp-info-cache
~*.lck
*.lck

# Scratch at the checkout root – agent tools create tmp/downloads/ in their working directory
/tmp/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
