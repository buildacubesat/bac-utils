# Build a CubeSat – bac-csr-ingest secrets
# Copy to .env and fill in values. Never commit .env.
# Non-secret settings live in ~/.config/bac/bac-csr-ingest.toml (run `bac-csr-ingest init`).
# Any CSR_* variable set here overrides the TOML value.

CSR_GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# CSR_REPO_ROOT=/path/to/CubeSat-Resources
# CSR_BUCKET_NAME=
# CSR_PUBLIC_BASE_URL=
# CSR_LLM_PROVIDER=openai
# CSR_LLM_MODEL=gpt-4.1-mini

# Extraction caches (with the `extract` extra)
# HF_HOME=/path/to/.cache/huggingface
# TORCH_HOME=/path/to/.cache/torch
