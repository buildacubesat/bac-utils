# bac-update-content-plan – secrets and machine-specific paths.
# Copy to .env in the directory you run the tool from (or above it), or
# pass the file with --env-file. Never commit the key itself.

# Service-account key (JSON) with read access to the content plan sheet.
# Share the sheet with the account's client_email like with a person.
BAC_GCP_CREDENTIALS=~/.config/bac/gcp-service-account.json
