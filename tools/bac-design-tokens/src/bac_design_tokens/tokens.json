{
  "$description": "Build a CubeSat design tokens – the canonical values of the BAC Identity Guide 1.0 and the BAC Interface Design Guide 1.0. W3C design-tokens format; a token's dark-mode value sits in $extensions.\"space.buildacubesat.modes\".dark. bac-design-tokens writes every copy from this file. SPDX-License-Identifier: MIT OR CC-BY-SA-4.0",
  "canonical": {
    "$description": "1. Canonical tokens – the same in light and dark",
    "typography": {
      "$description": "Typography – Identity Guide §3: Nunito wordmark, Nunito Sans headings (500) and body (400), IBM Plex Mono for labels, figures and code",
      "font-logo": { "$type": "fontFamily", "$value": ["Nunito", "system-ui", "sans-serif"], "$description": "wordmark only, uppercase" },
      "font-display": { "$type": "fontFamily", "$value": ["Nunito Sans", "system-ui", "sans-serif"] },
      "font-body": { "$type": "fontFamily", "$value": ["Nunito Sans", "system-ui", "sans-serif"] },
      "font-mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"], "$description": "labels, figures, identifiers, code – never body prose" },
      "fw-light": { "$type": "fontWeight", "$value": 300 },
      "fw-regular": { "$type": "fontWeight", "$value": 400 },
      "fw-medium": { "$type": "fontWeight", "$value": 500 },
      "fw-semibold": { "$type": "fontWeight", "$value": 600 },
      "fw-bold": { "$type": "fontWeight", "$value": 700 },
      "fw-heading": { "$type": "fontWeight", "$value": 500, "$description": "headings and display" },
      "text-2xs": { "$type": "dimension", "$value": "0.6875rem" },
      "text-xs": { "$type": "dimension", "$value": "0.75rem" },
      "text-sm": { "$type": "dimension", "$value": "0.8125rem" },
      "text-base": { "$type": "dimension", "$value": "0.9375rem" },
      "text-md": { "$type": "dimension", "$value": "1.0625rem" },
      "text-lg": { "$type": "dimension", "$value": "1.375rem" },
      "text-xl": { "$type": "dimension", "$value": "1.75rem" },
      "text-2xl": { "$type": "dimension", "$value": "2.25rem" },
      "text-3xl": { "$type": "dimension", "$value": "3rem" },
      "text-4xl": { "$type": "dimension", "$value": "4rem" },
      "text-5xl": { "$type": "dimension", "$value": "5.5rem" },
      "lh-tight": { "$type": "number", "$value": 1.05 },
      "lh-snug": { "$type": "number", "$value": 1.2 },
      "lh-normal": { "$type": "number", "$value": 1.45 },
      "lh-relaxed": { "$type": "number", "$value": 1.65 },
      "ls-tight": { "$type": "dimension", "$value": "-0.02em", "$description": "display headings" },
      "ls-normal": { "$type": "dimension", "$value": "0" },
      "ls-label": { "$type": "dimension", "$value": "0.03em", "$description": "uppercase mono labels, eyebrows, chips, buttons" }
    },
    "brand": {
      "$description": "Brand and status – Identity Guide §4.1; status fills are the same in both modes, text uses the inks below",
      "bac-yellow": { "$type": "color", "$value": "#F7D400", "$description": "light-mode primary action; caution in both modes" },
      "bac-yellow-press": { "$type": "color", "$value": "#EED228" },
      "bac-green": { "$type": "color", "$value": "#3FB950", "$description": "nominal, pass" },
      "bac-red": { "$type": "color", "$value": "#E94538", "$description": "alarm, fail" },
      "bac-blue": { "$type": "color", "$value": "#004C8B", "$description": "info; the hero card's fill" },
      "bac-blue-press": { "$type": "color", "$value": "#0B5CAD" }
    },
    "nebula": {
      "$description": "Nebula triad – Identity Guide §4.2; Mission and marketing only, never next to status colours",
      "nebula-teal": { "$type": "color", "$value": "#0E9594", "$description": "Orbital Teal" },
      "nebula-violet": { "$type": "color", "$value": "#7A5AF8", "$description": "Ion Violet" },
      "nebula-rose": { "$type": "color", "$value": "#C64677", "$description": "Plasma Rose – also Mission draft labels and ornamental bars" },
      "nebula-teal-tint": { "$type": "color", "$value": "#E1F3F2" },
      "nebula-violet-tint": { "$type": "color", "$value": "#ECEBFF" },
      "nebula-rose-tint": { "$type": "color", "$value": "#FFE7ED" },
      "mission-teal-ink": { "$type": "color", "$value": "#007878", "$description": "text on paper, white and the tint, AA" },
      "mission-violet-ink": { "$type": "color", "$value": "#6E4BE8" },
      "mission-rose-ink": { "$type": "color", "$value": "#B8396B" },
      "mission-teal-on-dark": { "$type": "color", "$value": "#1A9A99", "$description": "text on space-ink and space-surface, AA" },
      "mission-violet-on-dark": { "$type": "color", "$value": "#8F73FF" },
      "mission-rose-on-dark": { "$type": "color", "$value": "#DE5C8C" }
    },
    "neutral": {
      "$description": "Neutral ramp – Identity Guide §4.3; the light family (dark-mode surfaces are in the semantic block)",
      "neutral-0": { "$type": "color", "$value": "#FFFFFF" },
      "neutral-50": { "$type": "color", "$value": "#F9F9F9" },
      "neutral-100": { "$type": "color", "$value": "#F1F1F1" },
      "neutral-200": { "$type": "color", "$value": "#E6E6E6" },
      "neutral-300": { "$type": "color", "$value": "#D0D0D0" },
      "neutral-400": { "$type": "color", "$value": "#A9A9A9" },
      "neutral-500": { "$type": "color", "$value": "#8A8A8A" },
      "neutral-600": { "$type": "color", "$value": "#6D6D6D" },
      "neutral-700": { "$type": "color", "$value": "#4F4F4F" },
      "neutral-800": { "$type": "color", "$value": "#3F3F3F" },
      "neutral-900": { "$type": "color", "$value": "#282828" },
      "neutral-950": { "$type": "color", "$value": "#1F1F1F" }
    },
    "mission": {
      "$description": "Mission surfaces – Identity Guide §7",
      "space-ink": { "$type": "color", "$value": "#171320" },
      "space-surface": { "$type": "color", "$value": "#241B3F" },
      "space-paper": { "$type": "color", "$value": "#F4F1EA" },
      "space-muted": { "$type": "color", "$value": "#8F879E" },
      "mission-viewport-bg": { "$type": "color", "$value": "{space-ink}" },
      "mission-viewport-border": { "$type": "color", "$value": "rgba(14, 149, 148, 0.38)" },
      "mission-viewport-glow": { "$type": "shadow", "$value": "inset 0 0 24px rgba(14, 149, 148, 0.16), inset 0 0 72px rgba(122, 90, 248, 0.14)" },
      "mission-paper-well-bg": { "$type": "color", "$value": "rgba(255, 255, 255, 0.42)" },
      "mission-paper-well-border": { "$type": "color", "$value": "rgba(36, 27, 63, 0.14)" },
      "mission-paper-well-shadow": { "$type": "shadow", "$value": "inset 0 1px 2px rgba(255, 255, 255, 0.70), inset 0 -1px 3px rgba(23, 19, 32, 0.08)" }
    },
    "hero": {
      "$description": "Hero card – Interface Design Guide §6; one per view, same in both modes; the red rule is decorative, not an alarm",
      "hero-bg": { "$type": "color", "$value": "{bac-blue}" },
      "hero-text": { "$type": "color", "$value": "#FFFFFF" },
      "hero-rule": { "$type": "color", "$value": "{bac-red}" },
      "kicker": { "$type": "color", "$value": "{bac-yellow}", "$description": "the small brand bar before an eyebrow, both modes" }
    },
    "chart-shared": {
      "$description": "One chart palette for surfaces of unknown theme (marimo notebooks) – about 4:1 on white and on #1F1E1D",
      "chart-shared-1": { "$type": "color", "$value": "#2E7ED8" },
      "chart-shared-2": { "$type": "color", "$value": "#7D7D7D" },
      "chart-shared-3": { "$type": "color", "$value": "#9D7800" },
      "chart-shared-4": { "$type": "color", "$value": "#0E903A" },
      "chart-shared-5": { "$type": "color", "$value": "#E4463E" },
      "chart-seq-1": { "$type": "color", "$value": "#D6E6F8", "$description": "sequential ramp, low end" },
      "chart-seq-2": { "$type": "color", "$value": "{chart-shared-1}" },
      "chart-seq-3": { "$type": "color", "$value": "{bac-blue}", "$description": "sequential ramp, high end" }
    },
    "space": {
      "$description": "Spacing and containers – Identity Guide §5.1",
      "space-1": { "$type": "dimension", "$value": "4px" },
      "space-2": { "$type": "dimension", "$value": "8px" },
      "space-3": { "$type": "dimension", "$value": "12px" },
      "space-4": { "$type": "dimension", "$value": "16px" },
      "space-5": { "$type": "dimension", "$value": "24px" },
      "space-6": { "$type": "dimension", "$value": "32px" },
      "space-7": { "$type": "dimension", "$value": "48px" },
      "space-8": { "$type": "dimension", "$value": "64px" },
      "space-9": { "$type": "dimension", "$value": "96px" },
      "space-10": { "$type": "dimension", "$value": "128px" },
      "container": { "$type": "dimension", "$value": "1200px", "$description": "documents, storefront, reading pages" },
      "container-wide": { "$type": "dimension", "$value": "1540px", "$description": "dashboards and dense data views" },
      "container-narrow": { "$type": "dimension", "$value": "760px" }
    },
    "form": {
      "$description": "Corners and borders – Identity Guide §5.2, §5.4; no shadows, depth comes from background steps and hairlines",
      "radius-sm": { "$type": "dimension", "$value": "6px", "$description": "inputs, tags, small elements" },
      "radius-md": { "$type": "dimension", "$value": "10px", "$description": "cards, panels, surfaces" },
      "radius-pill": { "$type": "dimension", "$value": "100px", "$description": "buttons, chips, tabs" },
      "border-w": { "$type": "dimension", "$value": "1px" },
      "border-w-thick": { "$type": "dimension", "$value": "1.5px" }
    },
    "motion": {
      "$description": "Motion – Interface Design Guide §4.1",
      "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0.1, 1] },
      "ease-out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "dur-fast": { "$type": "duration", "$value": "120ms" },
      "dur-normal": { "$type": "duration", "$value": "200ms" },
      "dur-slow": { "$type": "duration", "$value": "320ms" }
    }
  },
  "semantic": {
    "$description": "2. Semantic tokens – light is the default, the dark value is the mode extension",
    "surface": {
      "$description": "Surfaces and text",
      "bg": { "$type": "color", "$value": "#F9F9F9", "$extensions": { "space.buildacubesat.modes": { "dark": "#1F1E1D" } } },
      "bg-raised": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "space.buildacubesat.modes": { "dark": "#232221" } } },
      "surface-card": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "space.buildacubesat.modes": { "dark": "#282726" } } },
      "surface-sunken": { "$type": "color", "$value": "#F1F1F1", "$extensions": { "space.buildacubesat.modes": { "dark": "#2F2E2D" } } },
      "surface-hover": { "$type": "color", "$value": "#E6E6E6", "$extensions": { "space.buildacubesat.modes": { "dark": "#353433" } } },
      "text": { "$type": "color", "$value": "#3F3F3F", "$extensions": { "space.buildacubesat.modes": { "dark": "#E5E5E5" } } },
      "text-strong": { "$type": "color", "$value": "#1F1F1F", "$extensions": { "space.buildacubesat.modes": { "dark": "#FFFFFF" } } },
      "text-muted": { "$type": "color", "$value": "#6D6D6D", "$extensions": { "space.buildacubesat.modes": { "dark": "#A9A8A6" } } },
      "text-faint": { "$type": "color", "$value": "#8A8A8A", "$description": "disabled and decorative only, never content", "$extensions": { "space.buildacubesat.modes": { "dark": "#858483" } } },
      "text-on-accent": { "$type": "color", "$value": "#3F3F3F", "$description": "text on yellow", "$extensions": { "space.buildacubesat.modes": { "dark": "#1F1E1D" } } },
      "border": { "$type": "color", "$value": "#E6E6E6", "$extensions": { "space.buildacubesat.modes": { "dark": "#353433" } } },
      "border-strong": { "$type": "color", "$value": "#D0D0D0", "$extensions": { "space.buildacubesat.modes": { "dark": "#3F3E3D" } } },
      "link": { "$type": "color", "$value": "#0B5CAD", "$extensions": { "space.buildacubesat.modes": { "dark": "#4C9AFF" } } },
      "focus-ring": { "$type": "color", "$value": "#0B5CAD", "$extensions": { "space.buildacubesat.modes": { "dark": "#4C9AFF" } } }
    },
    "action": {
      "$description": "Actions and state marks – yellow in light, neutral in dark (Interface Design Guide §3)",
      "btn-primary-bg": { "$type": "color", "$value": "#F7D400", "$extensions": { "space.buildacubesat.modes": { "dark": "#353433" } } },
      "btn-primary-hover": { "$type": "color", "$value": "#EED228", "$extensions": { "space.buildacubesat.modes": { "dark": "#3F3E3D" } } },
      "btn-primary-text": { "$type": "color", "$value": "#3F3F3F", "$extensions": { "space.buildacubesat.modes": { "dark": "#E5E5E5" } } },
      "accent-state": { "$type": "color", "$value": "#F7D400", "$description": "switch on, selected segment, current card, progress fill; a product's accent setting overrides only this pair", "$extensions": { "space.buildacubesat.modes": { "dark": "#E5E5E5" } } },
      "accent-state-text": { "$type": "color", "$value": "#3F3F3F", "$extensions": { "space.buildacubesat.modes": { "dark": "#1F1E1D" } } }
    },
    "status": {
      "$description": "Status inks (text on cards and tints) and tints",
      "bac-green-ink": { "$type": "color", "$value": "#1A7F37", "$extensions": { "space.buildacubesat.modes": { "dark": "#3FB950" } } },
      "bac-red-ink": { "$type": "color", "$value": "#C9302C", "$extensions": { "space.buildacubesat.modes": { "dark": "#FF5A4F" } } },
      "bac-blue-ink": { "$type": "color", "$value": "#0B5CAD", "$extensions": { "space.buildacubesat.modes": { "dark": "#4C9AFF" } } },
      "bac-yellow-ink": { "$type": "color", "$value": "#7A5F00", "$extensions": { "space.buildacubesat.modes": { "dark": "#F7D400" } } },
      "bac-green-tint": { "$type": "color", "$value": "#E8F7EA", "$description": "green 12 % into white; dark: 16 % into #1F1E1D", "$extensions": { "space.buildacubesat.modes": { "dark": "#243725" } } },
      "bac-red-tint": { "$type": "color", "$value": "#FCE9E7", "$description": "red 12 %; dark 16 %", "$extensions": { "space.buildacubesat.modes": { "dark": "#3F2421" } } },
      "bac-blue-tint": { "$type": "color", "$value": "#E6EDF3", "$description": "blue 10 %; dark 22 %", "$extensions": { "space.buildacubesat.modes": { "dark": "#182835" } } },
      "bac-yellow-tint": { "$type": "color", "$value": "#FEF7D1", "$description": "yellow 18 %; dark 14 %", "$extensions": { "space.buildacubesat.modes": { "dark": "#3D3719" } } }
    },
    "chart": {
      "$description": "Ops chart series in order – Interface Design Guide §8.1; green and red stay out of a chart that also carries pass/fail",
      "chart-1": { "$type": "color", "$value": "#0B5CAD", "$extensions": { "space.buildacubesat.modes": { "dark": "#4C9AFF" } } },
      "chart-2": { "$type": "color", "$value": "#3F3F3F", "$extensions": { "space.buildacubesat.modes": { "dark": "#E5E5E5" } } },
      "chart-3": { "$type": "color", "$value": "#B58F00", "$extensions": { "space.buildacubesat.modes": { "dark": "#F7D400" } } },
      "chart-4": { "$type": "color", "$value": "#1A7F37", "$extensions": { "space.buildacubesat.modes": { "dark": "#3FB950" } } },
      "chart-5": { "$type": "color", "$value": "#C9302C", "$extensions": { "space.buildacubesat.modes": { "dark": "#FF5A4F" } } },
      "chart-6": { "$type": "color", "$value": "#8A8A8A", "$extensions": { "space.buildacubesat.modes": { "dark": "#6B6B6B" } } }
    }
  }
}
